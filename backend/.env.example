# ─── AgentShield Environment Variables ───────────────────────────────────────
#
# Pick ONE of the free API providers below.
# GitHub Models is preferred (Microsoft ecosystem, free with GitHub account).
#
# Option 1: GitHub Models, recommended and free through Microsoft Azure Foundry
# Get your token: https://github.com/settings/tokens → Generate new token (classic) → no scopes needed
# NOTE: leave this commented until you have a real token. An uncommented placeholder
# value makes every request try (and fail) an 8-second LLM call before falling back.
# GITHUB_TOKEN=your_github_personal_access_token_here

# ── Option 2: Groq (free tier, very fast, Llama 3.1) ─────────────────────────
# Get your key: https://console.groq.com/
# GROQ_API_KEY=your_groq_api_key_here

# ── Option 3: OpenRouter (free models available) ──────────────────────────────
# Get your key: https://openrouter.ai/
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Note: Pattern-only mode ───────────────────────────────────────────────────
# If no API key is set, AgentShield still works using its 60+ pattern database.
# LLM deep analysis will be skipped but detection remains highly effective.

# ── Synthetic demo traffic (default OFF) ───────────────────────────────────────
# AGENTSHIELD_DEMO_TRAFFIC=true    # broadcasts a fabricated event every 10-15s
# These events are only broadcast to open dashboards, never stored, and the UI
# badges each one SYNTHETIC. (The old AGENTSHIELD_SEED_DATA option was removed:
# seeded rows had no tenant, so no caller could ever see them.)

# ── Production mode ─────────────────────────────────────────────────────────────
# AGENTSHIELD_ENV=production       # never print or save a generated admin key; no bootstrap key
# AGENTSHIELD_ADMIN_KEY=...        # set as a SECRET to enable admin routes (otherwise they are disabled)

# ── Public demo mode (default OFF) ──────────────────────────────────────────────
# AGENTSHIELD_PUBLIC_DEMO=true               # POST /api/demo/session mints private, expiring demo keys
# AGENTSHIELD_DEMO_KEY_TTL_SECONDS=3600
# AGENTSHIELD_DEMO_RATE_LIMIT_PER_MINUTE=30  # per demo key
# AGENTSHIELD_DEMO_MAX_ACTIVE_KEYS=300
# AGENTSHIELD_DEMO_MINT_PER_MINUTE=20        # global
# AGENTSHIELD_DEMO_LLM_CALLS_PER_HOUR=60     # shared by ALL demo visitors, protects your provider quota

# ── Privacy of the LLM layer ────────────────────────────────────────────────────
# With a provider key set, prompts of four or more words are sent to that provider.
# Secrets and PII found by the regex guard are masked first (default true).
# AGENTSHIELD_LLM_REDACT_BEFORE_SEND=true

# ── Retention ──────────────────────────────────────────────────────────────────
# AGENTSHIELD_EVENT_RETENTION_DAYS=30
# AGENTSHIELD_EVENT_CLEANUP_INTERVAL_SECONDS=3600
