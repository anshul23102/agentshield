# Required for the dashboard to authenticate against the backend.
# ./start.sh writes this into .env.local automatically from the backend's
# bootstrap key. For a manual `npm run dev`, get one from
# backend/data/.bootstrap_api_key or `python backend/scripts/create_api_key.py`.
VITE_API_KEY=ash_live_your_key_here

# Only needed to use the Dashboard's admin controls (clear cache, reset
# sessions, toggle demo traffic). From backend/data/.admin_key.
VITE_ADMIN_KEY=your_admin_key_here

# Only needed when the frontend isn't proxied to a local backend (deployed
# builds pointing at a separate API host).
# VITE_API_URL=https://agentshield-api-658e.onrender.com

# Only needed if the local backend isn't running on the default port 8000
# (e.g. it's already taken by something else). Read by vite.config.js to
# build the dev-server proxy target - no VITE_ prefix since it's config-time
# only, never shipped to the client bundle.
# BACKEND_PORT=8000
